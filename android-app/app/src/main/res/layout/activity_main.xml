<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_navy"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/brand_navy" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/errorPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/brand_navy"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RR"
                android:textColor="@color/brand_teal"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/offline_title"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/offline_message"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/retry" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:background="@color/surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="2dp">

        <Button
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/surface"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/nav_home"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navLaws"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/surface"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/nav_laws"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navAlerts"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/surface"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/nav_alerts"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navSave"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/surface"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/nav_save"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navSaved"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/surface"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/nav_saved"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />

        <Button
            android:id="@+id/navShare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:backgroundTint="@color/surface"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/nav_share"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
