{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/chat-admin",
      "destination": "/api/chat?admin=1"
    }
  ],
  "crons": [
    {
      "path": "/api/law-alert-dispatch",
      "schedule": "0 8 * * *"
    }
  ]
}
